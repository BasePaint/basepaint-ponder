# Mainnet HTTPS RPC URLs used for fetching blockchain data, comma separated
PONDER_RPC_URLS_8453="https://base.llamarpc.com,https://base.gateway.tenderly.co,https://1rpc.io/base"

# (Optional) How often to poll for new Base blocks, in milliseconds. Defaults to 2000 (Base block time).
# Changing it only needs a restart, not a reindex.
PONDER_POLLING_INTERVAL_MS_8453=2000

# (Optional) Database URL, if running via `npm run dev`
DATABASE_URL=postgress://localhost:5432/basepaint_ponder

# (Optional) Postgres password, if running via `docker compose`
POSTGRES_PASSWORD=hunter2
